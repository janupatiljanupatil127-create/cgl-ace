# Server Config
PORT=5000
NODE_ENV=development

# Database Config
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cgl_ace?schema=public"

# Security (JWT)
JWT_SECRET=super_secret_jwt_access_token_key_12345
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_54321
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# SMTP Email Config (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@cglace.com

# Cloudinary Storage Config (Multer)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
